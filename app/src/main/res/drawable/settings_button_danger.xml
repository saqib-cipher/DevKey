<?xml version="1.0" encoding="utf-8"?>
<!--
    Destructive action button (Reset). Uses a red-tinted surface with a
    stronger border so the user sees the warning state before tapping.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#3D1E26" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#55FF6666" />
</shape>

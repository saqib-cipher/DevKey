<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded card surface for the Settings UI. Lifted from #1A1A2E by ~6%
    so cards read as elevated panels above the page background without
    needing actual elevation (which doesn't render under DeviceDefault
    on older API levels). Stroke is a low-alpha accent so the rounded
    edge is visible against similar-tone neighbours.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#22223D" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>

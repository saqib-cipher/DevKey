<?xml version="1.0" encoding="utf-8"?>
<!--
    settings_activity.xml
    ──────────────────────────────────────────────────────────────────────────
    The full Settings UI for CodeKeys, separated from Java for readability.

    Surface design:
      • Page background uses a deep navy so accent / cyan colours read
        bright against it.
      • Cards (preview / enable / preferences / themes / etc) all share
        @drawable/settings_card_bg — a rounded-rect with a subtle 1dp
        stroke. Java reads view backgrounds as cards, so any container
        that previously used a flat #202036 fill now uses the drawable
        for a uniform, rounded look across the page.
      • Buttons split into primary (accent-tinted), secondary (neutral
        surface), and danger (Reset) variants — see
        settings_button_*.xml. Each is rounded so the page reads as a
        modern Material-ish surface even though we don't depend on
        Material at runtime.
      • Inputs use settings_input_bg so the inset feels recessed.
      • android:animateLayoutChanges on every dynamic container so card
        re-renders fade smoothly instead of snap-replacing.
    ──────────────────────────────────────────────────────────────────────────
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#15152A">

    <!--
        descendantFocusability + focusableInTouchMode together steal initial
        focus away from EditText children (edit_preview / edit_new_lang) so
        the soft keyboard does not auto-pop when the activity opens or after
        a theme rebuild. Users still get focus + keyboard the moment they
        actually tap into one of the EditText fields.

        animateLayoutChanges turns every add/remove of a child container into
        a smooth fade/translate transition so theme switches and dynamic
        container rebuilds feel polished instead of snap-replacing.
    -->
    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:animateLayoutChanges="true">

        <!-- ══════════════════════════════════════════════════════
             Title bar
        ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="24dp">

            <View
                android:id="@+id/title_swatch"
                android:layout_width="6dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/settings_title_swatch" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CodeKeys"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#F2F2FF" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coding Keyboard Settings"
                    android:textSize="12sp"
                    android:textColor="#9494B5" />
            </LinearLayout>

            <!-- Info / help button (top-right) -->
            <Button
                android:id="@+id/btn_info"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#00E5FF"
                android:background="@drawable/settings_button_secondary" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════
             TRY IT (preview field — type with the keyboard)
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_preview"
            style="@style/SettingsHeader"
            android:text="TRY IT" />

        <LinearLayout
            android:id="@+id/preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap below to test CodeKeys without leaving Settings."
                android:textSize="11sp"
                android:textColor="#9494B5"
                android:paddingBottom="10dp" />

            <EditText
                android:id="@+id/edit_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Try typing here…"
                android:textColor="#F2F2FF"
                android:textColorHint="#6A6A85"
                android:background="@drawable/settings_input_bg"
                android:padding="14dp"
                android:textSize="14sp"
                android:minLines="3"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences" />

            <Button
                android:id="@+id/btn_clear_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_gravity="end"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Clear"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textColor="#9494B5"
                android:background="@drawable/settings_button_secondary" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════
             Enable IME card
        ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/enable_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/settings_card_bg">

            <Button
                android:id="@+id/btn_enable_ime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:text="① Enable CodeKeys in System Settings  →"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#7BE8FF"
                android:background="@drawable/settings_button_primary" />

            <Button
                android:id="@+id/btn_pick_ime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="② Switch to CodeKeys (open IME picker)  →"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#F2F2FF"
                android:background="@drawable/settings_button_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="Tap ① to enable, then ② to activate CodeKeys as your keyboard."
                android:textSize="11sp"
                android:textColor="#9494B5" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════
             PREFERENCES
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_prefs"
            style="@style/SettingsHeader"
            android:text="PREFERENCES" />

        <LinearLayout
            android:id="@+id/preferences_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/settings_card_bg"
            android:animateLayoutChanges="true" />

        <!-- ══════════════════════════════════════════════════════
             THEMES
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_themes"
            style="@style/SettingsHeader"
            android:text="THEMES" />

        <!-- Themes are presented in a horizontal scroller so the user can
             swipe through them like a Gboard-style theme picker. The
             previous vertical list pushed the rest of the settings off
             screen on small phones; this layout keeps each preset visible
             as a richer detail card without crowding the page. -->
        <HorizontalScrollView
            android:id="@+id/themes_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <LinearLayout
                android:id="@+id/themes_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:animateLayoutChanges="true" />
        </HorizontalScrollView>

        <!-- Custom theme customisation: only visible when the user has
             selected the Custom theme entry. Colour rows are rendered at
             runtime by SettingsActivity#renderCustomThemePanel. -->
        <LinearLayout
            android:id="@+id/custom_theme_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="6dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/settings_card_bg"
            android:animateLayoutChanges="true" />

        <!-- ══════════════════════════════════════════════════════
             DEFAULT LANGUAGE MODE
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_lang"
            style="@style/SettingsHeader"
            android:text="DEFAULT LANGUAGE MODE" />

        <!--
            Language buttons live inside a HorizontalScrollView so users with
            many custom presets can swipe through them without truncating
            labels. Buttons themselves are wrap_content so each one is sized
            to its name (Java-side) instead of being squeezed into equal weight
            slots.
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/lang_buttons_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:animateLayoutChanges="true" />
        </HorizontalScrollView>

        <!-- ══════════════════════════════════════════════════════
             CUSTOM LANGUAGE PRESETS
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_custom_langs"
            style="@style/SettingsHeader"
            android:text="CUSTOM LANGUAGE PRESETS" />

        <LinearLayout
            android:id="@+id/custom_lang_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add your own language presets. They appear alongside the built-in ones in the keyboard's language popup."
                android:textSize="11sp"
                android:textColor="#9494B5"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/edit_new_lang"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="e.g. RUST"
                    android:textColor="#F2F2FF"
                    android:textColorHint="#6A6A85"
                    android:background="@drawable/settings_input_bg"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:inputType="textCapCharacters" />

                <Button
                    android:id="@+id/btn_add_lang"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Add"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#7BE8FF"
                    android:background="@drawable/settings_button_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/custom_lang_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:animateLayoutChanges="true" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════
             SNIPPET REFERENCE
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_snips"
            style="@style/SettingsHeader"
            android:text="SNIPPET REFERENCE" />

        <LinearLayout
            android:id="@+id/snippet_ref_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card_bg"
            android:animateLayoutChanges="true" />

        <!-- ══════════════════════════════════════════════════════
             BACKUP / RESTORE  (JSON import / export)
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_backup"
            style="@style/SettingsHeader"
            android:text="BACKUP &amp; RESTORE" />

        <LinearLayout
            android:id="@+id/backup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/settings_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export your themes, language snippets, and settings as JSON, then paste it back later or on another device."
                android:textSize="11sp"
                android:textColor="#9494B5"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_export"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:text="⇪ Export"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#7BE8FF"
                    android:background="@drawable/settings_button_primary" />

                <Button
                    android:id="@+id/btn_import"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:text="⇩ Import"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#F2F2FF"
                    android:background="@drawable/settings_button_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════
             RESET
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/header_reset"
            style="@style/SettingsHeader"
            android:text="RESET" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Reset All Settings to Default"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF8888"
            android:background="@drawable/settings_button_danger" />

        <!-- ══════════════════════════════════════════════════════
             Footer
        ══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="CodeKeys v1.0  •  Built for developers"
            android:textSize="11sp"
            android:textColor="#9494B5" />
    </LinearLayout>
</ScrollView>
